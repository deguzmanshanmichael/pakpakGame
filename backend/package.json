{
  "name": "pakpak-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for PakPak: accounts, sync, friends, messaging, trading, rewards and admin tools.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "create-admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/create-admin.js",
    "sync-catalog": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/sync-catalog.js"
  }
}
