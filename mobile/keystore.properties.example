# Copy to mobile/keystore.properties (git-ignored) to sign release builds.
# Create a key once with:
#   keytool -genkeypair -v -keystore pakpak-release.jks -alias pakpak -keyalg RSA -keysize 4096 -validity 10000
storeFile=pakpak-release.jks
storePassword=CHANGE_ME
keyAlias=pakpak
keyPassword=CHANGE_ME
