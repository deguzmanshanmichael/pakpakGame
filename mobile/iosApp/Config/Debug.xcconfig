// Backend for Debug builds. The simulator can reach a server on your Mac at localhost.
// For a real iPhone use your Mac's LAN IP, e.g. http:/$()/192.168.1.23:8080
// (the "$()" stops xcconfig from treating "//" as a comment).
PAKPAK_API_BASE_URL = http:/$()/localhost:8080
// Your Apple Developer Team ID (Xcode > Settings > Accounts). Needed only for real-device installs.
PAKPAK_TEAM_ID =
