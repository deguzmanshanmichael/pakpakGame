# Copy to .env and adjust. Never commit the real .env.

# HTTP port the API listens on (put a TLS reverse proxy such as Caddy or nginx in front in production).
PORT=8080
# Bind address. Use 0.0.0.0 to accept connections from a phone on your LAN during development.
HOST=127.0.0.1
# SQLite database file.
DB_PATH=./data/pakpak.db
# REQUIRED in production: long random string used to derive capsule rolls. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SERVER_SECRET=change-me-to-a-long-random-string
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
# production | development. Production refuses to start with the placeholder secret.
NODE_ENV=development
# Session lifetime in days.
SESSION_DAYS=30
